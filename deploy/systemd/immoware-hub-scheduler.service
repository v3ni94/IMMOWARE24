# Immoware Hub, Laravel Scheduler als einmaliger Lauf. Wird minuetlich vom Timer immoware-hub-scheduler.timer gestartet.
# Ablage: /etc/systemd/system/immoware-hub-scheduler.service

[Unit]
Description=Immoware Hub Scheduler (schedule:run)
After=network.target redis-server.service mariadb.service

[Service]
Type=oneshot
User=immoware
Group=immoware
WorkingDirectory=/var/www/immoware-hub/current
EnvironmentFile=-/etc/immoware-hub/worker.env
ExecStart=/usr/bin/php artisan schedule:run --no-interaction --no-ansi
TimeoutStartSec=300
Nice=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/immoware-hub/shared/storage /var/www/immoware-hub/current/bootstrap/cache
