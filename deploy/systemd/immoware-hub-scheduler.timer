# Immoware Hub, minuetlicher Timer fuer schedule:run.
# Ablage: /etc/systemd/system/immoware-hub-scheduler.timer
# Aktivieren: systemctl enable --now immoware-hub-scheduler.timer
# Pruefen:    systemctl list-timers immoware-hub-scheduler.timer

[Unit]
Description=Immoware Hub Scheduler, minuetlich

[Timer]
OnCalendar=*-*-* *:*:00
AccuracySec=1s
Persistent=false
Unit=immoware-hub-scheduler.service

[Install]
WantedBy=timers.target
