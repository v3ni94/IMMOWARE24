# Immoware Hub, Testumgebung (Stand 12.09.2026). Kopie als .env.testing ablegen (nicht im Repository).
# Entspricht den Werten in phpunit.xml; noetig fuer Kommandos mit --env=testing, z. B. php artisan migrate:fresh --env=testing.
# Alle Schreib-Flags bleiben false, HTTP nach aussen laeuft in Tests ausschliesslich ueber Http::fake().

APP_NAME="Immoware Hub Test"
APP_ENV=testing
APP_KEY=base64:8uZk3F2sV5m1cJzT9pQwXh7rL0aBdE4gN6yK1sU2vW8=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
BROADCAST_CONNECTION=null
BCRYPT_ROUNDS=4

HUB_BOOT_GUARD=true
HUB_API_KEYS_ENABLED=true
HUB_WEBHOOKS_ENABLED=false
IMMOWARE_READ_ENABLED=true
IMMOWARE_WRITE_ENABLED=false
IMMOWARE_WRITE_WEBDAV_CREATE_ENABLED=false
IMMOWARE_WRITE_WEBDAV_OVERWRITE_ENABLED=false
IMMOWARE_WRITE_WEBDAV_DELETE_ENABLED=false
IMMOWARE_WRITE_WEBDAV_MOVE_ENABLED=false
IMMOWARE_WRITE_CARDDAV_ENABLED=false
IMMOWARE_WRITE_CALDAV_ENABLED=false
