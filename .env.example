# Immoware Hub, Beispielkonfiguration (Stand 11.09.2026)
# Nur Platzhalter. Echte Werte gehoeren in den Secret-Store (KMS oder Vault), nie in dieses Repository.

APP_NAME="Immoware Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://immoware.muellerhv.de
APP_LOCALE=de
APP_FALLBACK_LOCALE=de

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=immoware_hub
DB_USERNAME=
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
# Redis-Queue: retry_after muss groesser sein als der laengste Job-Timeout (HUB_SYNC_JOB_TIMEOUT, Worker --timeout=1800),
# sonst wird ein laufender Sync-Job erneut ausgeliefert. Default 3600.
REDIS_QUEUE_RETRY_AFTER=3600

# Sync Engine (docs/immoware/07-sync-strategy.md Abschnitt 1.5 und 5). Cron-Ausdruecke in Europe/Berlin.
HUB_SYNC_QUEUE=sync
HUB_SYNC_JOB_TRIES=5
HUB_SYNC_JOB_TIMEOUT=900
HUB_SYNC_FULL_LOCK_TTL=7200
HUB_SYNC_SCHEDULE_ENABLED=true
HUB_SYNC_CRON_DOCUMENTS="*/30 * * * *"
HUB_SYNC_CRON_CONTACTS="0 * * * *"
HUB_SYNC_CRON_CALENDAR="0 */4 * * *"
HUB_SYNC_CRON_FULL="0 22 * * 6"
HUB_SYNC_CRON_STALE="*/15 * * * *"
# Mark-and-Sweep: Soft Delete erst nach zwei aufeinanderfolgenden vollstaendigen Laeufen ohne Treffer (Abschnitt 4)
HUB_CONTACTS_SWEEP_REQUIRED_MISSES=2
HUB_CALENDAR_SWEEP_REQUIRED_MISSES=2
# Pepper fuer HMAC-SHA256 (ip_address_hash, iban_hash, base_url_hash, config/hub/security.php). In production Pflicht,
# hub:doctor meldet sonst fail und deploy.sh bricht ab. Zufaelliger Wert, z. B. openssl rand -hex 32. Nie rotieren, ohne
# die gehashten Spalten neu zu berechnen. deploy/scripts/server-bootstrap.sh setzt den Wert einmalig.
HUB_HASH_PEPPER=
# 08-security.md Abschnitt 3.1: Secure, SameSite=Strict, 30 Minuten inaktiv, 8 Stunden absolut (HUB_SESSION_ABSOLUTE_MINUTES)
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
SESSION_LIFETIME=30
HUB_SESSION_ABSOLUTE_MINUTES=480

# Blob-Speicher (S3-kompatibel, EU-Standort) fuer Payloads ueber 64 KB und Importdateien
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Immoware24 DAV-Adapter (WebDAV, CalDAV, CardDAV)
# Es gibt KEINE globalen DAV-Zugangsdaten in der ENV. Freigabe-Link, Benutzername und Freigabe-Passwort liegen je
# technischem Nutzer und Connection verschluesselt in der Datenbank (immoware_technical_users, immoware_connections)
# und werden ueber die Admin-UI gesetzt. Belegstatus und Quellen zu Freigabe-Link, Benutzername und Freigabe-Passwort
# stehen ausschliesslich in docs/immoware/04-authentication.md (Abschnitte 2.2 und 2.3); diese Datei vergibt keinen Status.
# Schluessel fuer die App-Level-Encryption (docs/immoware/08-security.md Abschnitt 2.2), Referenz auf KMS oder Vault, kein Klartextschluessel:
HUB_ENCRYPTION_KEY_PROVIDER=
HUB_ENCRYPTION_KEY_ID=

# Lesepfad
IMMOWARE_READ_ENABLED=true

# Schreibpfad. Variablennamen und Semantik gemaess docs/immoware/05-write-capabilities.md Abschnitt 2.1.
# Standard ist ueberall false. Aktivierung nur nach Vier-Augen-Freigabe und protokollierter Freigabe der Geschaeftsfuehrung.
# Ein Wert true bei OVERWRITE, DELETE, MOVE, CARDDAV oder CALDAV verhindert den Start der Anwendung (fest verdrahtet).
# Ein DELETE-Writeback existiert nicht und wird nicht gebaut.
IMMOWARE_WRITE_ENABLED=false
IMMOWARE_WRITE_WEBDAV_CREATE_ENABLED=false
IMMOWARE_WRITE_WEBDAV_OVERWRITE_ENABLED=false
IMMOWARE_WRITE_WEBDAV_DELETE_ENABLED=false
IMMOWARE_WRITE_WEBDAV_MOVE_ENABLED=false
IMMOWARE_WRITE_CARDDAV_ENABLED=false
IMMOWARE_WRITE_CALDAV_ENABLED=false
IMMOWARE_WRITE_ALLOWED_PREFIX=/Posteingang/
IMMOWARE_WRITE_MAX_UPLOAD_BYTES=26214400
IMMOWARE_WRITE_VERIFY_WITH_HASH=true
IMMOWARE_WRITE_UNKNOWN_PROPFIND_ATTEMPTS=3
IMMOWARE_WRITE_UNKNOWN_PROPFIND_INTERVAL_SECONDS=300
IMMOWARE_WRITE_MAX_CONCURRENCY=1
IMMOWARE_WRITE_DRY_RUN=false

# Feste konservative Limits (keine Immoware24-Angaben belegt, Status NICHT VERFUEGBAR). Leitdokument: docs/immoware/07-sync-strategy.md Abschnitt 6.
IMMOWARE_RATE_LIMIT_RPS=2
IMMOWARE_MAX_CONCURRENCY_READ=2

# Drop-Ordner fuer manuelle Exporte (CSV-Auswertungen, DATEV, CAMT)
HUB_IMPORT_DROP_PATH=
HUB_IMPORT_REQUIRE_METADATA=true

# Ausgehende Webhooks und API-Keys (Module vorhanden, erst mit benanntem Konsumenten aktiv; Namen gemaess docs/immoware/05-write-capabilities.md Abschnitt 2.1)
HUB_WEBHOOKS_ENABLED=false
HUB_API_KEYS_ENABLED=false
HUB_WEBHOOK_REPLAY_WINDOW_SECONDS=300

MAIL_MAILER=log
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Betrieb (Aenderungsvermerk 12.09.2026, docs/operations/01-deployment.md Abschnitt 4 und 03-monitoring.md)
# REDIS_QUEUE_RETRY_AFTER=3600, SESSION_SECURE_COOKIE=true, SESSION_SAME_SITE=strict stehen oben in den Bloecken Queue und Session.
# Vertrauenswuerdige Proxys fuer X-Forwarded-*: nur die IP oder das CIDR des TLS-Proxys (z. B. 127.0.0.1 oder 10.0.0.0/8),
# kommagetrennt, nie "*". Ohne Eintrag sieht die Anwendung die Proxy-Adresse als Client-IP (IP-Allowlist der API-Keys,
# Login-Throttle, ip_address_hash im Audit).
TRUSTED_PROXIES=127.0.0.1
# Docker Compose: der Proxy ist der Container web im Netz backend, also das Docker-Subnetz (server-bootstrap-docker.sh
# setzt 172.28.0.0/16). compose.yaml liest zusaetzlich DB_ROOT_PASSWORD (MariaDB-Container), IMAGE_TAG (Rollback),
# WEB_BIND und WEB_PORT (Standard 127.0.0.1:8080) aus dieser Datei.
# Integritaets-Trigger in MariaDB (audit_logs append-only, write_operations.put_attempts <= 1). Nur fuer Testdatenbanken
# auf false setzen. Wird ausschliesslich beim Migrieren gelesen (docs/architecture/03-mariadb-triggers.sql).
HUB_DB_TRIGGERS=true

# Mail-Modul (docs/mail/01-architekturentscheidung.md). Alle Flags standardmaessig false; ein Flag allein schaltet nichts frei.
MAIL_APP_DOMAIN=mail.muellerhv.de
MAIL_DISPLAY_TIMEZONE=Europe/Berlin
MAIL_IMPORT_ENABLED=false
MAIL_AI_ENABLED=false
MAIL_GMAIL_DRAFTS_ENABLED=false
MAIL_GMAIL_SEND_ENABLED=false
MAIL_IMMOWARE_WRITE_ENABLED=false
MAIL_LEXWARE_WRITE_ENABLED=false
MAIL_PAPERLESS_WRITE_ENABLED=false
# Provider je Integration: leer = Nicht eingerichtet, live, fake (fake nur ausserhalb production)
MAIL_GMAIL_PROVIDER=
MAIL_AI_PROVIDER=
MAIL_LEXWARE_PROVIDER=
MAIL_DRIVE_PROVIDER=
MAIL_PAPERLESS_PROVIDER=
# Queues mail-high, mail-sync, mail-ai. Eigener Worker fuer mail-high (compose.yaml mail-worker-high,
# deploy/supervisor/immoware-hub-mail-worker.conf, deploy/systemd/immoware-hub-mail-worker@.service).
MAIL_QUEUE_HIGH=mail-high
MAIL_QUEUE_SYNC=mail-sync
MAIL_QUEUE_AI=mail-ai
MAIL_JOB_TRIES=5
MAIL_JOB_TIMEOUT=300
MAIL_PUSH_RATE_LIMIT_PER_MINUTE=600
MAIL_UI_PER_PAGE=50
MAIL_ATTACHMENT_MAX_BYTES=26214400

# Gmail (Mailsystem). OAuth-Client aus der Google Cloud Console; leer = "Nicht eingerichtet". Redirect-URI je Umgebung
# muss exakt im OAuth-Client hinterlegt sein. Pub/Sub-Push zeigt auf https://mail.muellerhv.de/mail/gmail/push[/{PATH_TOKEN}]
# (Pfad ohne /api, weil die API-Key-Middleware Pub/Sub nicht bedienen kann); MAIL_GMAIL_PUSH_AUDIENCE ist diese URL.
# Alle Endpunkte und Antwortformate stammen aus Snippets und sind vor Produktivbetrieb am Original zu pruefen.
MAIL_GMAIL_CLIENT_ID=
MAIL_GMAIL_CLIENT_SECRET=
MAIL_GMAIL_API_BASE_URL=https://gmail.googleapis.com/gmail/v1
MAIL_GMAIL_API_TIMEOUT=30
MAIL_GMAIL_API_CONNECT_TIMEOUT=10
MAIL_GMAIL_REDIRECT_URI_PRODUCTION=https://mail.muellerhv.de/mail/integrations/gmail/callback
MAIL_GMAIL_REDIRECT_URI_STAGING=
MAIL_GMAIL_REDIRECT_URI_LOCAL=http://mail.test/mail/integrations/gmail/callback
MAIL_GMAIL_PUSH_TOPIC=
MAIL_GMAIL_PUSH_AUDIENCE=
MAIL_GMAIL_PUSH_SERVICE_ACCOUNT=
MAIL_GMAIL_PUSH_PATH_TOKEN=
MAIL_GMAIL_INITIAL_IMPORT_MAX=500
MAIL_GMAIL_INITIAL_IMPORT_DAYS=90
MAIL_GMAIL_QUOTA_PER_MINUTE=5000
MAIL_GMAIL_MESSAGE_ID_DOMAIN=mail.muellerhv.de
MAIL_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token

# Lexware Office (Rechnungsprogramm). Leer = "Nicht eingerichtet". Schreiben nur mit MAIL_LEXWARE_WRITE_ENABLED und Freigabe.
MAIL_LEXWARE_API_KEY=
MAIL_LEXWARE_BASE_URL=https://api.lexoffice.io/v1
MAIL_LEXWARE_RATE_LIMIT_RPS=1

# KI-Vorschlaege (OpenAI und Anthropic). Nur mit MAIL_AI_ENABLED, MAIL_AI_PROVIDER=live, API-Key, Modell und AVV;
# kein Modell-Default. MAIL_AI_PROVIDER_PRIORITY legt die Reihenfolge fest, Standard OpenAI vor Anthropic
# (Kostenentscheidung); ist der erste Anbieter nicht eingerichtet oder nicht erreichbar, greift der naechste.
# Budget in Cent und Token je Tag und Monat (UTC), gilt anbieteruebergreifend; Preise optional fuer die Kostenschaetzung.
MAIL_AI_PROVIDER_PRIORITY=openai,anthropic
MAIL_AI_API_KEY=
MAIL_AI_MODEL=
MAIL_AI_BASE_URL=https://api.openai.com/v1
MAIL_AI_API_MODE=responses
MAIL_AI_TIMEOUT_SECONDS=60
MAIL_AI_RETRY_TIMES=2
MAIL_AI_DAILY_BUDGET_CENTS=500
MAIL_AI_MONTHLY_BUDGET_CENTS=5000
MAIL_AI_DAILY_TOKENS=2000000
MAIL_AI_MONTHLY_TOKENS=30000000
MAIL_AI_PRICE_INPUT_CENTS_PER_MILLION=
MAIL_AI_PRICE_OUTPUT_CENTS_PER_MILLION=
MAIL_AI_MAX_INPUT_CHARS=20000
MAIL_AI_MAX_OUTPUT_TOKENS=2000
MAIL_AI_MAX_CONTEXT_EXCERPTS=5
MAIL_AI_MAX_CONTEXT_EXCERPT_CHARS=1500
MAIL_AI_MASK_EMAIL=true
MAIL_AI_MASK_PHONE=true
MAIL_AI_ANTHROPIC_API_KEY=
MAIL_AI_ANTHROPIC_MODEL=
MAIL_AI_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
MAIL_AI_ANTHROPIC_VERSION=2023-06-01
MAIL_AI_ANTHROPIC_TIMEOUT_SECONDS=60
MAIL_AI_ANTHROPIC_RETRY_TIMES=2
MAIL_AI_ANTHROPIC_MAX_OUTPUT_TOKENS=2000
MAIL_AI_ANTHROPIC_PRICE_INPUT_CENTS_PER_MILLION=
MAIL_AI_ANTHROPIC_PRICE_OUTPUT_CENTS_PER_MILLION=

# Google Drive (Dokumentenquelle, nur lesend). Leer = "Nicht eingerichtet". Ordnerzuordnung Objekt zu Ordner-ID als JSON.
MAIL_DRIVE_CLIENT_ID=
MAIL_DRIVE_CLIENT_SECRET=
MAIL_DRIVE_API_BASE_URL=https://www.googleapis.com/drive/v3
MAIL_DRIVE_ROOT_FOLDER_ID=
MAIL_DRIVE_FOLDER_MAP=
MAIL_DRIVE_TIMEOUT_SECONDS=20
MAIL_DRIVE_EXCERPT_MAX_CHARS=4000

# Paperless-ngx (Dokumentenablage, lesend und schreibend, create-only). Leer = "Nicht eingerichtet". Ein technischer
# API-Token fuer den ganzen Hub, kein OAuth-Fluss. Objektnummer-Zusatzfeld muss in Paperless bereits angelegt sein.
# Auf dms.muellerhv.de (Stand 24.09.2026) ist dies Feld-ID 7 ("MHV Objekt"), nicht das leere Feld "Objekt-Nr" (ID 1).
MAIL_PAPERLESS_BASE_URL=
MAIL_PAPERLESS_API_TOKEN=
MAIL_PAPERLESS_OBJECT_NUMBER_FIELD_ID=
MAIL_PAPERLESS_TIMEOUT_SECONDS=20
MAIL_PAPERLESS_EXCERPT_MAX_CHARS=4000

# SLA, Notfall und Bereitschaft. Leer = "keine 24/7-Betreuung eingerichtet" (Hinweis im Alarm und in der Oberflaeche).
MAIL_ON_CALL_USER_IDS=
MAIL_EMERGENCY_WEBHOOK_URL=
MAIL_EMERGENCY_FROM=

# Aktionsengine (Freigaben, Ausfuehrung, Verifikation). Deep-Link-Muster ohne Default, sonst kein Link in Aufgaben.
MAIL_ACTION_QUEUE=mail-high
MAIL_ACTION_APPROVAL_TTL_HOURS=72
MAIL_ACTION_JOB_TRIES=3
MAIL_ACTION_JOB_TIMEOUT=120
MAIL_ACTION_LOCK_SECONDS=300
MAIL_ACTION_VERIFY_DELAY=60
MAIL_ACTION_IMMOWARE_MAX_AGE=86400
MAIL_ACTION_IMMOWARE_DEEP_LINK=

# Lernphase Immoware24 (Modul Learning). Schreibt nie nach Immoware24, aendert keine Konfigurationsdatei automatisch.
HUB_LEARNING_ENABLED=false
HUB_LEARNING_AI_ENABLED=false
HUB_LEARNING_WEBDAV_MAX_DEPTH=8
HUB_LEARNING_WEBDAV_MAX_FOLDERS=800
HUB_LEARNING_WEBDAV_SAMPLE_FILENAMES=8
HUB_LEARNING_PER_PAGE=25

# Prozessdatenbank (Modul Playbooks). Regelbasierter Vergleich ist immer kostenlos; KI nur bei unklarem Ergebnis
# und nur zusaetzlich zu MAIL_AI_ENABLED und MAIL_AI_PROVIDER=live.
HUB_PLAYBOOKS_ENABLED=false
HUB_PLAYBOOKS_AI_ENABLED=false
HUB_PLAYBOOKS_MATCH_HIGH_THRESHOLD=80
HUB_PLAYBOOKS_MATCH_LOW_THRESHOLD=35
HUB_PLAYBOOKS_MATCH_MAX_CANDIDATES=5
